generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["ledger", "minos", "pilotos"]
}

model MinosUser {
  id                     Int                @id @default(autoincrement())
  email                  String             @unique @db.VarChar(255)
  password_hash          String             @db.VarChar(255)
  role                   String?            @default("user") @db.VarChar(50)
  created_at             DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?          @default(now()) @updatedAt @db.Timestamptz(6)
  google_access_token    String?
  google_refresh_token   String?
  google_token_expiry    BigInt?
  google_email           String?            @db.VarChar(255)
  gmail_connected        Boolean?           @default(false)
  forwarding_verified    Boolean?           @default(false)
  nombre                 String?            @db.VarChar(255)
  nif_cif                String?            @db.VarChar(50)
  stripe_customer_id     String?            @db.VarChar(100)
  stripe_subscription_id String?            @db.VarChar(100)
  cuota_mensual          Decimal?           @default(0.00) @db.Decimal(10, 2)
  estado_pago            String?            @default("AL DIA") @db.VarChar(20)
  fecha_bloqueo          DateTime?          @db.Timestamp(6)
  telefono               String?            @db.VarChar(50)
  gmail_last_scan        DateTime?          @db.Timestamptz(6)
  LegalAcceptances       LegalAcceptances[]
  clientesPilotOS        Cliente[]
  conductoresPilotOS     Conductor[]

  @@map("Users")
  @@schema("minos")
}

model LedgerEvento {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo_evento   String    @db.VarChar(100)
  dedupe_key    String    @unique @db.VarChar(500)
  timestamp     DateTime? @default(now()) @db.Timestamptz(6)
  datos         Json
  estado        String?   @default("OK") @db.VarChar(20)
  source        String?   @default("UNKNOWN") @db.VarChar(50)
  error_message String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@index([dedupe_key], map: "idx_eventos_dedupe")
  @@index([timestamp(sort: Desc)], map: "idx_eventos_timestamp")
  @@index([tipo_evento], map: "idx_eventos_tipo")
  @@map("Eventos")
  @@schema("ledger")
}

model Cliente {
  id                     String                   @id @default(uuid())
  patron_id              Int
  nombre_comercial       String?
  tipo_actividad         String                   @default("TAXI")
  activo                 Boolean                  @default(true)
  // M8 (auditoria seguridad 2026-07-24): preferencias de aviso de mantenimiento
  // por cliente. Antes existia un campo homonimo en Onboarding sin forma
  // definida ni consumidor; ver services/mantenimientoAlertas.service.ts
  // (resolverPreferenciasAvisos) para el esquema y los valores por defecto.
  preferencias_avisos    Json?
  created_at             DateTime                 @default(now())
  updated_at             DateTime                 @updatedAt
  cierresPeriodo         CierrePeriodo[]
  patron                 MinosUser                @relation(fields: [patron_id], references: [id])
  conductores            Conductor[]
  configuracionEconomica ConfiguracionEconomica[]
  gastosFijos            GastoFijo[]
  vehiculos              Vehiculo[]

  @@map("clientes")
  @@schema("pilotos")
}

model Conductor {
  id                 String                   @id @default(uuid())
  cliente_id         String
  usuario_id         Int
  es_patron          Boolean                  @default(false)
  activo             Boolean                  @default(true)
  created_at         DateTime                 @default(now())
  updated_at         DateTime                 @updatedAt
  anomalias          Anomalia[]
  cliente            Cliente                  @relation(fields: [cliente_id], references: [id])
  usuario            MinosUser                @relation(fields: [usuario_id], references: [id])
  configuraciones    ConfiguracionEconomica[]
  partesDiarios      ParteDiario[]
  vehiculosAsignados VehiculoConductor[]

  @@unique([cliente_id, usuario_id])
  @@map("conductores")
  @@schema("pilotos")
}

model Vehiculo {
  id                  String                  @id @default(uuid())
  cliente_id          String
  matricula           String                  @unique
  marca               String
  modelo              String
  fecha_matriculacion DateTime
  tipo_combustible    String
  tipo_transmision    String
  km_actuales         Int
  activo              Boolean                 @default(true)
  created_at          DateTime                @default(now())
  updated_at          DateTime                @updatedAt
  gastosFijos         GastoFijo[]
  mantenimientos      MantenimientoVehiculo[]
  partesDiarios       ParteDiario[]
  conductores         VehiculoConductor[]
  cliente             Cliente                 @relation(fields: [cliente_id], references: [id])
  // Documentos que NO nacen de un parte diario (factura de taller, ITV,
  // seguro...). Ver Documento.vehiculo_id — 2026-08-11.
  documentos          Documento[]

  @@map("vehiculos")
  @@schema("pilotos")
}

model VehiculoConductor {
  id           String    @id @default(uuid())
  vehiculo_id  String
  conductor_id String
  activo       Boolean   @default(true)
  created_at   DateTime  @default(now())
  conductor    Conductor @relation(fields: [conductor_id], references: [id])
  vehiculo     Vehiculo  @relation(fields: [vehiculo_id], references: [id])

  @@unique([vehiculo_id, conductor_id])
  @@map("vehiculo_conductores")
  @@schema("pilotos")
}

model ConfiguracionEconomica {
  id                             String         @id @default(uuid())
  cliente_id                     String
  modelo_reparto                 String         @default("PORCENTAJE")
  porcentaje_conductor           Decimal        @default(50) @db.Decimal(5, 2)
  porcentaje_patron              Decimal        @default(50) @db.Decimal(5, 2)
  cuota_pilotos                  Decimal        @default(0) @db.Decimal(10, 2)
  incluye_combustible_en_reparto Boolean        @default(true)
  notas                          String?
  conductor_id                   String?
  fecha_inicio                   DateTime       @default(now())
  fecha_fin                      DateTime?
  activo                         Boolean        @default(true)
  created_at                     DateTime       @default(now())
  updated_at                     DateTime       @updatedAt
  calculosPartes                 CalculoParte[]
  cliente                        Cliente        @relation(fields: [cliente_id], references: [id])
  conductor                      Conductor?     @relation(fields: [conductor_id], references: [id])

  @@map("configuracion_economica")
  @@schema("pilotos")
}

model ParteDiario {
  id               String            @id @default(uuid())
  fecha_trabajada  DateTime          @db.Date
  fecha_envio      DateTime          @default(now())
  vehiculo_id      String
  conductor_id     String
  km_inicio        Int
  km_fin           Int
  ingreso_bruto    Decimal           @db.Decimal(10, 2)
  ingreso_datafono Decimal           @db.Decimal(10, 2)
  combustible      Decimal?          @db.Decimal(10, 2)
  varios           Decimal?          @db.Decimal(10, 2)
  concepto_varios  String?
  estado           String            @default("ENVIADO")
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  calculo          CalculoParte?
  documentos       DocumentoEnlace[]
  incidencias      Incidencia[]
  conductor        Conductor         @relation(fields: [conductor_id], references: [id])
  vehiculo         Vehiculo          @relation(fields: [vehiculo_id], references: [id])

  @@unique([vehiculo_id, fecha_trabajada])
  @@map("partes_diarios")
  @@schema("pilotos")
}

model CalculoParte {
  id                            String                 @id @default(uuid())
  parte_diario_id               String                 @unique
  configuracion_id              String
  bruto_diario                  Decimal                @db.Decimal(10, 2)
  combustible                   Decimal                @default(0) @db.Decimal(10, 2)
  neto_diario                   Decimal                @db.Decimal(10, 2)
  base_reparto                  Decimal                @default(0) @db.Decimal(10, 2)
  varios                        Decimal                @default(0) @db.Decimal(10, 2)
  parte_conductor               Decimal                @db.Decimal(10, 2)
  parte_patron                  Decimal                @db.Decimal(10, 2)
  modelo_reparto_aplicado       String
  porcentaje_conductor_aplicado Decimal                @db.Decimal(5, 2)
  porcentaje_patron_aplicado    Decimal                @db.Decimal(5, 2)
  created_at                    DateTime               @default(now())
  configuracion                 ConfiguracionEconomica @relation(fields: [configuracion_id], references: [id])
  parteDiario                   ParteDiario            @relation(fields: [parte_diario_id], references: [id])

  @@map("calculos_partes")
  @@schema("pilotos")
}

model Documento {
  id                    String               @id @default(uuid())
  tipo                  String
  url                   String
  drive_file_id         String?
  hash_sha256           String?
  estado                String               @default("RECIBIDO")
  ocr_texto             String?
  ocr_confianza         Float?
  ocr_datos_extraidos   Json?
  intentos_reemplazo    Int                  @default(0)
  subido_por_usuario_id Int?
  ocr_error             String?
  estado_ocr            String?              @default("PENDIENTE")
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  enlaces               DocumentoEnlace[]
  historial             DocumentoHistorial[]

  // 2026-08-11 — terreno para "el propietario manda una foto por WhatsApp y
  // el sistema la encaja sola" (petición de Alberto). Deliberadamente NO se
  // reutiliza DocumentoEnlace: esa tabla tiene un FK físico a ParteDiario
  // (`entidad_id` solo puede apuntar a un parte), así que un documento sin
  // parte —factura de taller, ITV, seguro— no cabe ahí sin un refactor
  // grande y arriesgado de los ~10 sitios que ya la consultan (ver hallazgo
  // de la auditoría, punto 23 / tarea G2 del plan, que sigue pendiente por
  // separado). Estos dos campos son la vía corta y segura: un documento
  // puede nacer sin vehiculo_id/mantenimiento_vehiculo_id (recién llegado,
  // sin clasificar todavía) y rellenarlos cuando se sepa qué es.
  //
  // Convención de `tipo` para estos documentos (además de los ya existentes
  // TICKET_TAXIMETRO/TICKET_GASOIL/TICKET_COMBUSTIBLE):
  //   DOCUMENTO_VEHICULO_SIN_CLASIFICAR — recién recibido, nadie ha
  //     determinado todavía si es factura de taller, ITV, seguro...
  //     (la clasificación automática NO está construida, ver informe)
  //   FACTURA_TALLER / CERTIFICADO_ITV / POLIZA_SEGURO — una vez
  //     clasificado (manual hoy; automático cuando se construya la
  //     extracción con un documento real de referencia)
  vehiculo_id               String?
  mantenimiento_vehiculo_id String?
  vehiculo                  Vehiculo?              @relation(fields: [vehiculo_id], references: [id])
  mantenimientoVehiculo     MantenimientoVehiculo? @relation(fields: [mantenimiento_vehiculo_id], references: [id])

  @@map("documentos")
  @@schema("pilotos")
}

model DocumentoEnlace {
  id           String      @id @default(uuid())
  documento_id String
  entidad_tipo String
  entidad_id   String
  created_at   DateTime    @default(now())
  parteDiario  ParteDiario @relation(fields: [entidad_id], references: [id], map: "doc_enlace_parte_fk")
  documento    Documento   @relation(fields: [documento_id], references: [id])

  @@unique([documento_id, entidad_tipo, entidad_id])
  @@map("documento_enlaces")
  @@schema("pilotos")
}

model DocumentoHistorial {
  id           String    @id @default(uuid())
  documento_id String
  url_anterior String
  motivo       String
  created_at   DateTime  @default(now())
  documento    Documento @relation(fields: [documento_id], references: [id])

  @@map("documento_historial")
  @@schema("pilotos")
}

model TareaPendiente {
  id           String    @id @default(uuid())
  tipo         String
  entidad_tipo String
  entidad_id   String
  conductor_id String
  resuelta     Boolean   @default(false)
  created_at   DateTime  @default(now())
  resolved_at  DateTime?

  @@map("tareas_pendientes")
  @@schema("pilotos")
}

model Anomalia {
  id              String    @id @default(uuid())
  conductor_id    String
  tipo            String
  descripcion     String
  notificada      Boolean   @default(false)
  parte_diario_id String?
  documento_id    String?
  estado          String    @default("ACTIVA")
  // 2026-08-11: el patrón puede marcarla como revisada desde el panel — el
  // WhatsApp puede no llegar, pasar desapercibido u olvidarse de contestar;
  // la anomalía se queda en rojo en el panel hasta que él decide que ya la
  // ha hablado con el asalariado. `estado` ya existía en el schema pero
  // nunca se actualizaba desde ningún endpoint.
  revisada_at     DateTime?
  revisada_por    Int? // MinosUser.id del patrón que la marcó
  created_at      DateTime  @default(now())
  conductor       Conductor @relation(fields: [conductor_id], references: [id])

  @@map("anomalias")
  @@schema("pilotos")
}

model Incidencia {
  id              String      @id @default(uuid())
  parte_diario_id String
  que_ocurrio     String
  decision_tomada String
  justificacion   String
  autorizador_id  String
  estado          String      @default("CREADA")
  created_at      DateTime    @default(now())
  closed_at       DateTime?
  parteDiario     ParteDiario @relation(fields: [parte_diario_id], references: [id])

  @@map("incidencias")
  @@schema("pilotos")
}

model Gasto {
  id          String   @id @default(uuid())
  cliente_id  String
  vehiculo_id String?
  tipo        String
  descripcion String
  importe     Decimal  @db.Decimal(10, 2)
  fecha       DateTime @db.Date
  forma_pago  String?
  url_factura String?
  estado      String   @default("REGISTRADO")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("gastos")
  @@schema("pilotos")
}

model GastoFijo {
  id           String    @id @default(uuid())
  cliente_id   String
  vehiculo_id  String?
  tipo         String
  descripcion  String
  importe      Decimal   @db.Decimal(10, 2)
  periodicidad String
  activo       Boolean   @default(true)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  cliente      Cliente   @relation(fields: [cliente_id], references: [id])
  vehiculo     Vehiculo? @relation(fields: [vehiculo_id], references: [id])

  @@map("gastos_fijos")
  @@schema("pilotos")
}

model MantenimientoCatalogo {
  id               String                  @id @default(uuid())
  nombre           String                  @unique
  tipo             String
  frecuencia_km    Int?
  frecuencia_meses Int?
  activo           Boolean                 @default(true)
  created_at       DateTime                @default(now())
  vehiculos        MantenimientoVehiculo[]

  @@map("mantenimiento_catalogo")
  @@schema("pilotos")
}

model MantenimientoVehiculo {
  id                     String                     @id @default(uuid())
  vehiculo_id            String
  catalogo_id            String
  ultima_ejecucion_km    Int?
  ultima_ejecucion_fecha DateTime?
  proximo_km             Int?
  proxima_fecha          DateTime?
  estado                 String                     @default("PENDIENTE")
  frecuencia_aprendida   Int?
  activo                 Boolean                    @default(true)
  frecuencia_km_personalizada    Int?
  frecuencia_meses_personalizada Int?
  // Fase 6 (2026-07-24): ultimo escalon de aviso ya notificado, para no
  // avisar el mismo umbral cada dia (dedupe). null = ningun aviso emitido
  // todavia. Ver services/mantenimientoAlertas.service.ts para la semantica
  // de los niveles (1000/500/250/0/-250/... para km, 30/0/-15/... para dias).
  ultimo_nivel_aviso_km   Int?
  ultimo_nivel_aviso_dias Int?
  created_at             DateTime                   @default(now())
  updated_at             DateTime                   @updatedAt
  catalogo               MantenimientoCatalogo      @relation(fields: [catalogo_id], references: [id])
  vehiculo               Vehiculo                   @relation(fields: [vehiculo_id], references: [id])
  seguimiento            SeguimientoMantenimiento[]
  // Factura/documento que resolvió (o que se está evaluando si resuelve)
  // este mantenimiento — 2026-08-11, terreno para el reconocimiento OCR
  // de facturas (todavía sin construir la extracción, ver docs/learning).
  documentos             Documento[]

  @@unique([vehiculo_id, catalogo_id])
  @@map("mantenimientos_vehiculos")
  @@schema("pilotos")
}

model SeguimientoMantenimiento {
  id                        String                @id @default(uuid())
  mantenimiento_vehiculo_id String
  accion                    String
  detalle                   String?
  km_en_momento             Int?
  created_at                DateTime              @default(now())
  mantenimientoVehiculo     MantenimientoVehiculo @relation(fields: [mantenimiento_vehiculo_id], references: [id])

  @@map("seguimiento_mantenimiento")
  @@schema("pilotos")
}

model Aviso {
  id           String    @id @default(uuid())
  cliente_id   String
  tipo         String
  titulo       String
  mensaje      String
  entidad_tipo String?
  entidad_id   String?
  leido        Boolean   @default(false)
  enviado      Boolean   @default(false)
  enviado_at   DateTime?
  // Fase 6 (2026-07-24): trazabilidad real de envio (antes no existia
  // ningun registro de intento/error para los avisos generados por el
  // scheduler de mantenimientos).
  canal        String    @default("whatsapp")
  intentos     Int       @default(0)
  error_envio  String?
  // 2026-08-11: desde que PilotOS envía directo a Meta (sin la cola de
  // n8n), la deduplicación es responsabilidad nuestra — la cola ya no nos
  // la da gratis. Clave estable por hecho avisado, NO por fecha:
  //   mantenimiento -> `pilotos:mant:<mantenimiento_id>:<escalon>`
  //   anomalía      -> `pilotos:anomalia:<parte_id>`
  // Si un envío falla, la fila se conserva con enviado=false y el escalón
  // se revierte, así que mañana se reintenta con la MISMA clave: se
  // reutiliza la fila en vez de duplicar el aviso.
  dedupe_key   String?   @unique
  created_at   DateTime  @default(now())

  @@map("avisos")
  @@schema("pilotos")
}

/// Códigos de recuperación de contraseña (2026-08-11).
///
/// Hasta hoy PilotOS no tenía forma de recuperar el acceso: si olvidabas la
/// contraseña había que editar el hash a mano en la base de datos. Pasó dos
/// veces en cuatro días (C-039 el 7 de agosto, otra vez el 11).
///
/// El código NUNCA se guarda en claro: solo su hash. Quien lea esta tabla no
/// puede entrar en ninguna cuenta.
model PasswordReset {
  id          String    @id @default(uuid())
  /// minos.Users.id — no hay FK porque minos es de otro producto del ecosistema.
  usuario_id  Int
  codigo_hash String
  expira_at   DateTime
  /// Un código sirve UNA vez. Al usarlo se sella aquí.
  usado_at    DateTime?
  /// Intentos fallidos contra este código; al pasarse, se quema.
  intentos    Int       @default(0)
  created_at  DateTime  @default(now())

  @@index([usuario_id])
  @@index([expira_at])
  @@map("password_resets")
  @@schema("pilotos")
}

model CierrePeriodo {
  id                     String   @id @default(uuid())
  cliente_id             String
  periodo_inicio         DateTime @db.Date
  periodo_fin            DateTime @db.Date
  total_bruto            Decimal  @db.Decimal(10, 2)
  total_combustible      Decimal  @db.Decimal(10, 2)
  total_neto             Decimal  @db.Decimal(10, 2)
  total_gastos_fijos     Decimal  @db.Decimal(10, 2)
  total_gastos_variables Decimal  @db.Decimal(10, 2)
  total_conductor        Decimal  @db.Decimal(10, 2)
  total_patron           Decimal  @db.Decimal(10, 2)
  cuota_pilotos          Decimal  @db.Decimal(10, 2)
  num_partes             Int
  estado                 String   @default("BORRADOR")
  pdf_url                String?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt
  cliente                Cliente  @relation(fields: [cliente_id], references: [id])

  // Fase 4 (2026-07-24): antes no habia ninguna restriccion que impidiera
  // generar dos cierres para el mismo cliente y el mismo rango de fechas.
  @@unique([cliente_id, periodo_inicio, periodo_fin], map: "cierres_periodo_cliente_periodo_key")
  @@map("cierres_periodo")
  @@schema("pilotos")
}

model Onboarding {
  id                  String    @id @default(uuid())
  telefono            String    @unique
  completado          Boolean   @default(false)
  nombre_patron       String?
  email_patron        String?
  nif_cif             String?
  nombre_comercial    String?
  tipo_actividad      String?
  asalariados         Json?
  gastos_fijos        Json?
  matricula           String?
  marca_modelo        String?
  fecha_matriculacion DateTime?
  tipo_combustible    String?
  tipo_transmision    String?
  km_actuales         Int?
  seguro_vigencia     DateTime?
  preferencias_avisos Json?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@map("onboarding")
  @@schema("pilotos")
}

model LegalAcceptances {
  id                      Int        @id @default(autoincrement())
  user_id                 Int?
  product_key             String     @db.VarChar
  accepted_pilot_terms    Boolean    @default(false)
  accepted_privacy_policy Boolean    @default(false)
  accepted_marketing      Boolean    @default(false)
  ip_address              String?    @db.VarChar
  user_agent              String?
  accepted_at             DateTime?  @default(now()) @db.Timestamp(6)
  Users                   MinosUser? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_legal_acceptances_user")
  @@schema("minos")
}
