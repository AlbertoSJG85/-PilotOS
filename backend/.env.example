# PilotOS Backend — Variables de entorno
# Copiar a .env y rellenar con valores reales

# Servidor
PORT=3001
NODE_ENV=production

# Base de datos PostgreSQL (BD compartida nexos, schema pilotos)
DATABASE_URL="postgresql://USER:PASSWORD@161.97.108.106:5433/nexos?schema=pilotos"

# Auth (compartido con ecosistema NexOS — NO usar fallbacks)
JWT_SECRET=

# Comunicacion interna entre productos (GlorIA → PilotOS)
INTERNAL_API_TOKEN=

# Comunicacion interna PilotOS → GlorIA (Fase 6, 2026-07-24: avisos de
# mantenimiento). Sin estas dos variables, notificacion.service.ts no intenta
# el envio y lo deja constatado en el Aviso correspondiente (error_envio).
# GLORIA_API_URL=https://gloria.nexostudios.digital
# GLORIA_INTERNAL_TOKEN=

# CORS — origenes permitidos en produccion (separados por coma)
ALLOWED_ORIGINS=https://pilotos.nexostudios.digital

# n8n (orquestacion de workflows)
N8N_WEBHOOK_URL=https://n8n.nexostudios.digital/webhook

# Storage (fase 1: local, futuro: S3-compatible)
# MINIO_ENDPOINT=
# MINIO_PORT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=pilotos-fotos
# NexOS Pay — activar solo tras catálogo, migración y backfill en staging.
NEXOS_PAY_ENABLED=false
NEXOS_PAY_ENFORCE_ACCESS=false
NEXOS_PAY_ENFORCE_PLAN_GATES=false
NEXOS_PAY_URL=http://localhost:3005
NEXOS_PAY_INTERNAL_TOKEN=change-me
NEXOS_PAY_PLAN_DEFECTO=pilotos_control
NEXOS_PAY_PLAN_PRO=pilotos_pro
NEXOS_PAY_EXENCION=fase_prueba
NEXOS_PAY_TIMEOUT_MS=5000

# ── Correo (2026-08-12) ────────────────────────────────────────────────
# El código de recuperación de contraseña sale por aquí. Antes iba por
# WhatsApp y dependía de que Meta aprobara una plantilla: a 12 de agosto no
# habían aprobado ninguna, así que la recuperación no funcionaba para nadie.
# Sin SMTP_URL no se envía nada y queda un error claro en el log.
# SMTP_URL=smtps://usuario:clave@smtp.tu-proveedor.com:465
# EMAIL_REMITENTE=PilotOS <info@nexostudios.digital>

# ── Drive del cliente (2026-08-12) ─────────────────────────────────────
# Los documentos del taxi (ITV, facturas) se copian al Drive DEL CLIENTE,
# no a uno nuestro. Sin estas variables la función queda apagada y ni
# siquiera se ofrece en la interfaz.
# Se reutiliza la app de Google de RentOS: hay que añadir la URL de retorno
# de PilotOS en la consola de Google Cloud y activar la API de Drive.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_DRIVE_REDIRECT_URI=https://api.pilotos.nexostudios.digital/api/drive/callback
# Clave para cifrar los tokens (32 bytes en hex): openssl rand -hex 32
# DRIVE_ENCRYPTION_KEY=...
